DirectoryIndex index.php index.html
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:application|\.git)(?:/|$) - [F,L,NC]
    # Temporary public holding page for both domains and all website paths.
    # Remove these three rules together when the store is ready for launch.
    RewriteRule ^coming-soon\.html$ - [L]
    RewriteRule ^assets/favicon\.svg$ - [L]
    RewriteRule ^ coming-soon.html [L]
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Cache-Control "no-store, max-age=0"
</IfModule>
