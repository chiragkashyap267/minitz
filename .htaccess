DirectoryIndex index.php index.html
Options -Indexes
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:application|\.git)(?:/|$) - [F,L,NC]
    # The front controller defaults to Coming Soon. Private preview requires
    # a server-only marker plus an authenticated administrator session.
    RewriteRule ^(?:deployment|tests|assets/preview)(?:/|$) - [F,L,NC]
    RewriteRule ^assets/ - [L]
    RewriteCond %{DOCUMENT_ROOT}/application/storage/public-store-enabled -f
    RewriteRule ^(?:index\.html|coming-soon\.html)$ / [R=302,L]
    RewriteRule ^coming-soon\.html$ - [L]
    RewriteRule ^ index.php [L]
</IfModule>
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Cache-Control "no-store, max-age=0"
</IfModule>
