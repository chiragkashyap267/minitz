{
  "name": "minitz/store",
  "description": "Minitz custom storefront and management dashboard",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": "^8.2",
    "laravel/framework": "^12.0",
    "dompdf/dompdf": "^3.1",
    "guzzlehttp/guzzle": "^7.9"
  },
  "autoload": { "psr-4": { "App\\": "app/", "Database\\Seeders\\": "database/seeders/" }, "files": ["app/helpers.php"] },
  "config": { "optimize-autoloader": true, "sort-packages": true },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "scripts": { "pre-install-cmd": ["@php prepare.php"], "pre-update-cmd": ["@php prepare.php"], "post-autoload-dump": ["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump", "@php artisan package:discover --ansi"] }
}
